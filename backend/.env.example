PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/stockfact_pro
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Origines autorisées (séparées par virgule)
# Ajouter ici l'URL Vercel du frontend après déploiement
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Exemple production :
# ALLOWED_ORIGINS=http://localhost:5173,https://stockfact-pro.vercel.app
